<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="guessmarket.client.component.login.LoginController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Enter your user name to join the market" style="-fx-font-size: 16px;"/>
    <HBox alignment="CENTER" spacing="8">
        <Label text="User name:"/>
        <TextField fx:id="userNameTextField" prefWidth="220" onKeyTyped="#userNameKeyTyped" onAction="#loginButtonClicked"/>
    </HBox>
    <Label fx:id="errorMessageLabel" wrapText="true" maxWidth="420" style="-fx-text-fill: red;"/>
    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="loginButton" text="Login" onAction="#loginButtonClicked"/>
        <Button text="Quit" onAction="#quitButtonClicked"/>
    </HBox>
</VBox>
